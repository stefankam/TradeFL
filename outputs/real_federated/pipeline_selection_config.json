        "communication_bytes": {
          "availability": 53687091200,
          "reducer": "sum",
          "initial_price": 1.862645149230957e-11,
          "maximum_price": 1.862645149230957e-10
        }
      }
    }
  },
  "dataset": {
    "name": "pubmedqa",
